---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';

/**
 * Further Reading: An Annotated Bibliography — the book's own back matter.
 *
 * Each work keeps the author's note and her line on why it matters to the
 * novel. Groupings and order follow the printed page rather than being
 * re-sorted.
 */

const works = (await getCollection('reading')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(works.map(async (w) => ({ ...w, Body: (await render(w)).Content })));

const sections: { name: string; works: typeof rendered }[] = [];
for (const w of rendered) {
  const last = sections.at(-1);
  if (last?.name === w.data.section) last.works.push(w);
  else sections.push({ name: w.data.section, works: [w] });
}
---

<BaseLayout
  title="Further Reading"
  description="The book's annotated bibliography — the works behind its world, across surveillance, science denial, caste, climate collapse and resistance."
  readingProgress
>
  <div class="shell section">
    <header class="page-head stack">
      <p class="eyebrow">From the book</p>
      <h1>Further Reading</h1>
      <p class="text-muted lede">
        These selected works offer critical context to <em>The Very Last Superhero</em>'s world.
        They illuminate the intellectual, political and ecological crises that underpin the book's
        speculative setting, drawing connections across surveillance, science denial, caste, climate
        collapse and resistance.
      </p>
      <p class="count">{works.length} works, in {sections.length} groups</p>
    </header>

    {
      sections.map((section) => (
        <section class="group">
          <h2 class="group__name">{section.name}</h2>
          <ol class="works">
            {section.works.map(({ id, data, Body }) => (
              <li class="work" id={id}>
                <p class="work__author">{data.author}</p>
                <h3>{data.title}</h3>
                {data.publisher && (
                  <p class="work__pub">
                    {data.publisher}
                    {data.year && `, ${data.year}`}
                  </p>
                )}
                <div class="work__note prose">
                  <Body />
                </div>
                {data.relevance && (
                  <p class="work__rel">
                    <span>Relevance</span> {data.relevance}
                  </p>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <Newsletter />
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-block-end: var(--space-2xl);
  }

  .lede {
    max-width: 62ch;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .group + .group {
    margin-block-start: var(--space-2xl);
  }

  .group__name {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber);
    padding-block-end: var(--space-xs);
    margin-block-end: var(--space-xl);
    border-block-end: 1px solid var(--border);
  }

  .works {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
  }

  .work {
    max-width: 64ch;
    scroll-margin-block-start: 6rem;
  }

  .work__author {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .work h3 {
    font-size: var(--step-1);
    margin-block: var(--space-3xs) var(--space-3xs);
  }

  .work__pub {
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .work__note {
    margin-block-start: var(--space-xs);
    font-size: var(--step--1);
  }

  .work__rel {
    margin-block-start: var(--space-xs);
    padding-inline-start: var(--space-s);
    border-inline-start: 2px solid color-mix(in srgb, var(--amber) 40%, transparent);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .work__rel span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
    display: block;
  }
</style>
