---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import { site } from '../lib/site';

/**
 * What to do about it.
 *
 * The novel's argument is that resilience is systems and documentation rather
 * than heroism, so this page points at people doing exactly that, and links
 * only to organisations whose sites were checked to resolve.
 */

const steps = (await getCollection('act-steps')).sort((a, b) => a.data.order - b.data.order);
const rsteps = await Promise.all(steps.map(async (s) => ({ ...s, Body: (await render(s)).Content })));
function groupBy<T extends { data: { group: string } }>(items: T[]) {
  const map = new Map<string, T[]>();
  for (const item of items) {
    const bucket = map.get(item.data.group);
    if (bucket) bucket.push(item);
    else map.set(item.data.group, [item]);
  }
  return [...map].map(([name, items]) => ({ name, items }));
}

const stepGroups = groupBy(rsteps);

const orgs = (await getCollection('action')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(orgs.map(async (o) => ({ ...o, Body: (await render(o)).Content })));

const groups = groupBy(rendered);
---

<BaseLayout
  title="How to Help"
  description="The parts of this novel that are not fiction, and the people already working on them — transparency, air, waste, land, and the movements you can actually join."
  readingProgress
>
  <div class="shell section">
    <header class="page-head stack">
      <p class="eyebrow">Not fiction</p>
      <h1>How to Help</h1>
      <blockquote class="frame">
        <p>
          The Very Last Superhero is grounded in Delhi's actual, ongoing reality. The Okhla
          Waste-to-Energy plant exists. The heat exists. The failed tech, the air so dense with
          particulate that memory feels physical — this is not fiction.
        </p>
        <footer>
          Varna Sri Raman, <a href="/making">On the Making</a>
        </footer>
      </blockquote>
      <p class="text-muted lede">
        The book's answer is not a hero. It is documentation, doubt, and people who keep turning up
        — a tea stall, a post office, a librarian who did not stop. Here are some of the people
        doing that now.
      </p>
    </header>

    <section class="steps">
      <h2 class="steps__head">Start here</h2>
      <p class="text-muted steps__lede">
        Ordered by what it costs you, not by how important it sounds. None of it requires being the
        sort of person who does this kind of thing.
      </p>

      {
        stepGroups.map((group) => (
          <div class="tier">
            <p class="tier__name">{group.name}</p>
            <ol class="tier__list">
              {group.items.map(({ data, Body }) => (
                <li class="step">
                  <h3>{data.title}</h3>
                  <div class="step__note prose">
                    <Body />
                  </div>
                  <a class="step__link" href={data.url} rel="noopener">
                    {data.linkLabel} →
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </section>

    <section class="campaign">
      <p class="campaign__label">The campaign this book is dedicated to</p>
      <h2>{site.campaign.label}</h2>
      <p class="text-muted">
        Dev, to whom the book is partly dedicated, has been fighting Delhi's waste-to-energy plants
        for years. Rohan's work in the novel is drawn from it.
      </p>
      <a class="button" href={site.campaign.url} rel="noopener">Read about the campaign</a>
    </section>

    <h2 class="orgs__head">Who is already doing this</h2>
    <p class="text-muted orgs__lede">
      Sixteen organisations whose work is the real version of what the novel imagines. None of them
      endorsed this book or know it exists.
    </p>

    {
      groups.map((group) => (
        <section class="group">
          <h2 class="group__name">{group.name}</h2>
          <ul class="orgs">
            {group.items.map(({ data, Body }) => (
              <li class="org">
                <h3>
                  <a href={data.url} rel="noopener">
                    {data.name}
                  </a>
                </h3>
                <div class="org__note prose">
                  <Body />
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <p class="note text-muted">
      None of these organisations endorsed this book or know it exists. They are listed because
      their work is the real version of what the novel imagines, and because every link here was
      checked to resolve before it went up. If one has gone stale, or one belongs here and is
      missing, <a href="/contact">say so</a>.
    </p>

    <Newsletter />
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-block-end: var(--space-2xl);
  }

  .frame {
    margin: var(--space-m) 0 0;
    padding-inline-start: var(--space-m);
    border-inline-start: 2px solid var(--amber);
    max-width: 58ch;
  }

  .frame p {
    font-family: var(--font-display);
    font-size: var(--step-1);
    text-wrap: pretty;
  }

  .frame footer {
    margin-block-start: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .lede {
    max-width: 60ch;
  }

  .steps {
    margin-block-end: var(--space-2xl);
  }

  .steps__head {
    font-size: var(--step-2);
  }

  .steps__lede {
    max-width: 58ch;
    margin-block: var(--space-2xs) var(--space-xl);
  }

  .tier + .tier {
    margin-block-start: var(--space-xl);
  }

  .tier__name {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber);
    margin-block-end: var(--space-s);
  }

  .tier__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(24rem, 100%), 1fr));
  }

  .step {
    padding: var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-sunken);
    display: flex;
    flex-direction: column;
  }

  .step h3 {
    font-size: var(--step-0);
  }

  .step__note {
    margin-block: var(--space-2xs) var(--space-s);
    font-size: var(--step--1);
    color: var(--text-muted);
    flex: 1;
  }

  .step__link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    align-self: start;
  }

  .orgs__head {
    font-size: var(--step-2);
    margin-block-start: var(--space-2xl);
  }

  .orgs__lede {
    max-width: 58ch;
    margin-block: var(--space-2xs) var(--space-xl);
  }

  .campaign {
    padding: var(--space-l);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-sunken);
    max-width: 60ch;
    margin-block-end: var(--space-2xl);
  }

  .campaign__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber);
  }

  .campaign h2 {
    font-size: var(--step-1);
    margin-block: var(--space-2xs) var(--space-xs);
  }

  .campaign .button {
    margin-block-start: var(--space-s);
  }

  .group + .group {
    margin-block-start: var(--space-2xl);
  }

  .group__name {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber);
    padding-block-end: var(--space-xs);
    margin-block-end: var(--space-xl);
    border-block-end: 1px solid var(--border);
  }

  .orgs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
  }

  .org {
    max-width: 64ch;
  }

  .org h3 {
    font-size: var(--step-1);
  }

  .org__note {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .note {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--border);
    font-size: var(--step--1);
    max-width: 62ch;
  }
</style>
