---
import { Image } from 'astro:assets';
import { getCollection, getEntries } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const objects = (await getCollection('archive')).sort((a, b) => a.data.order - b.data.order);
const withLinks = await Promise.all(
  objects.map(async (o) => ({ object: o, related: await getEntries(o.data.related) }))
);

const statusLabel = {
  recovered: 'Recovered',
  corrupted: 'Corrupted',
  pending: 'Artwork pending',
} as const;
---

<BaseLayout
  title="Archive Objects"
  description="Catalogued artefacts of the Resistance — object tags, memory tablets, authentication discs and the compliance charts of the 2061 curriculum rewrite."
>
  <div class="shell section">
    <header class="page-head stack">
      <p class="eyebrow">Catalogue</p>
      <h1>Archive Objects</h1>
      <p class="text-muted lede">
        Artefacts recovered from the Resistance network. Entries marked <em>artwork pending</em> are
        catalogued but not yet illustrated.
      </p>
    </header>

    <div class="objects">
      {
        withLinks.map(({ object, related }) => (
          <article
            class:list={['card', 'object', `object--${object.data.status}`]}
          >
            <div class="card__media">
              {object.data.image ? (
                <Image
                  src={object.data.image}
                  alt={object.data.imageAlt ?? ''}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 40rem) 90vw, 20rem"
                  loading="lazy"
                />
              ) : (
                <div class="placeholder">
                  <span class="placeholder__mark" aria-hidden="true">◌</span>
                  <span class="placeholder__text">Artwork not yet recovered</span>
                </div>
              )}
            </div>

            <div class="card__body">
              {object.data.designation && <p class="eyebrow">{object.data.designation}</p>}
              <h2>{object.data.title}</h2>
              <p class="text-muted summary">{object.data.summary}</p>

              <p class="object__foot">
                <span
                  class:list={[
                    'badge',
                    object.data.status === 'corrupted' && 'badge--corrupted',
                    object.data.status === 'pending' && 'badge--pending',
                  ]}
                >
                  {statusLabel[object.data.status]}
                </span>
                {related.map((r) => (
                  <a class="object__link" href={`/lore/${r.id}`}>
                    {r.data.title}
                  </a>
                ))}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* Wider than the shared .grid-auto: object cards carry an image plus a
     paragraph, and at 17rem they read as a scatter of thumbnails rather than a
     catalogue. */
  .objects {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr));
  }

  .page-head {
    margin-block-end: var(--space-l);
  }

  .lede {
    max-width: 54ch;
  }

  .object h2 {
    font-size: var(--step-1);
  }

  .summary {
    font-size: var(--step--1);
  }

  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    width: 100%;
    height: 100%;
    background:
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 8px,
        color-mix(in srgb, var(--border) 50%, transparent) 8px,
        color-mix(in srgb, var(--border) 50%, transparent) 9px
      ),
      var(--bg-sunken);
    color: var(--text-faint);
  }

  .placeholder__mark {
    font-size: 1.8rem;
    line-height: 1;
  }

  .placeholder__text {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .object__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-block-start: auto;
    padding-block-start: var(--space-s);
  }

  .object__link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .object--pending .card__body h2 {
    color: var(--text-muted);
  }
</style>
