---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const wallpapers = (await getCollection('wallpapers')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Wallpapers"
  description="Wallpapers from The Very Last Superhero — portrait pieces for a phone, landscape plates for a desktop, free to download for personal use."
>
  <div class="shell section">
    <header class="page-head stack">
      <p class="eyebrow">The Sumati Series</p>
      <h1>Wallpapers</h1>
      <p class="text-muted lede">
        Free for personal use under
        <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" rel="license noopener"
          >CC BY-NC-ND 4.0</a
        >. Open one to view it full size, then save it the way you normally save an image.
      </p>
      <p>
        <a class="button" href="/sigil">Or make your own with the Firebird Sigil generator →</a>
      </p>
    </header>

    <div class="wall-grid">
      {
        wallpapers.map((w) => (
          <figure class="paper">
            <a
              href={w.data.image.src}
              target="_blank"
              rel="noopener"
              aria-label={`Open ${w.data.title} at full size`}
            >
              {
                /* The grid is auto-fill minmax(15rem), so a card is about 18rem
                   on a wide screen and near full width on a phone. The old
                   sizes claimed 15rem/45vw, which had the browser fetch a 240px
                   file for a slot needing 576px at 2x — and 1050px on a 3x
                   phone. That upscaling was the "grain", not the artwork. */
              }
              <Image
                src={w.data.image}
                alt={w.data.imageAlt}
                widths={[320, 480, 640, 960, 1280]}
                sizes="(max-width: 40rem) 92vw, 22rem"
                loading="lazy"
              />
            </a>
            <figcaption>
              <h2>{w.data.title}</h2>
              <p class="text-muted">{w.data.summary}</p>
              <p class="paper__size">
                {w.data.image.width} × {w.data.image.height}
                <span> · {w.data.orientation === 'phone' ? 'portrait' : 'landscape'}</span>
              </p>
              <a class="button" href={w.data.image.src} target="_blank" rel="noopener">
                Open full size
              </a>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* Stated plainly, because these are the artwork's real pixels. Enlarging them
     to a round 1920 only amplified the paper texture in the originals into
     what reads as grain. */
  .paper__size {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
    margin-block: var(--space-2xs);
  }

  .paper__size span {
    opacity: 0.7;
  }

  .page-head {
    margin-block-end: var(--space-xl);
  }

  .lede {
    max-width: 54ch;
  }

  .wall-grid {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
  }

  .paper {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .paper img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    transition: border-color 0.2s var(--ease);
  }

  .paper a:hover img {
    border-color: var(--amber);
  }

  .paper h2 {
    font-size: var(--step-1);
  }

  .paper p {
    font-size: var(--step--1);
    margin-block: var(--space-2xs) var(--space-xs);
  }
</style>
