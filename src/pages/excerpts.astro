---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BuyButton from '../components/BuyButton.astro';
import { Content } from '../content/excerpt/chapter-one.md';
import { site } from '../lib/site';
import { getBookPrice, formatRupees } from '../lib/price';
import cover from '../assets/cover.jpg';

const { price } = await getBookPrice();
---

<BaseLayout
  title="Excerpts and extras"
  description="Read the prologue and the first chapter of The Very Last Superhero free, as printed in the First Edition. Fourteen-year-old Sumati, a hot Delhi morning, and a father who is about to vanish."
  readingProgress
>
  <div class="shell section">
    <header class="page-head stack">
      <p class="eyebrow">From the book</p>
      <h1>Excerpts and extras</h1>
      <p class="lede text-muted">The prologue and Chapter 1, as printed in the First Edition.</p>
    </header>

    <article class="prose read stack">
      <Content />
    </article>

    <section class="buy-band" aria-labelledby="excerpts-buy">
      <Image
        class="buy-band__cover"
        src={cover}
        alt="Cover of The Very Last Superhero: a man in a cape holds a child's hand against a red sunset."
        widths={[240, 400]}
        sizes="200px"
        loading="lazy"
      />
      <div class="stack buy-band__text">
        <p class="eyebrow">Keep reading</p>
        <h2 id="excerpts-buy">Chapter 2, Left Behind, continues in the book</h2>
        <p class="buy-band__meta">
          {site.edition} &middot; ISBN {site.isbn} &middot; Paperback, {formatRupees(price)}
        </p>
        <div class="buy-band__actions">
          <BuyButton placement="excerpts" />
          <a
            class="button buy-publisher"
            data-buy
            data-placement="excerpts-publisher"
            href={site.buy.publisher}
            target="_blank"
            rel="noopener"
            data-umami-event="buy-click"
            data-umami-event-placement="excerpts-publisher"
          >Buy direct from the publisher</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    max-width: 65ch;
    margin-inline: auto;
    margin-block-end: var(--space-xl);
  }

  .read {
    width: min(100%, 65ch);
    margin-inline: auto;
    font-size: var(--step-0);
    line-height: 1.8;
  }

  .read :global(h2) {
    margin-block-start: var(--space-2xl);
  }

  .read :global(.chapter-label) {
    margin-block-end: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .read :global(.chapter-label + h2) {
    margin-block-start: var(--space-2xs);
  }

  /* Epigraphs and the memorial line. */
  .read :global(blockquote) {
    margin-inline: 0;
    padding-inline: var(--space-m);
    border-inline-start: 2px solid var(--amber);
    font-family: var(--font-display);
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .read :global(blockquote p) {
    margin: 0;
  }

  .read :global(blockquote p + p) {
    margin-block-start: var(--space-xs);
  }

  .read :global(cite) {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-style: normal;
    color: var(--text-faint);
  }

  /* The declassified debrief: an in-world document, set apart. */
  .read :global(.document) {
    padding: var(--space-m);
    border: 1px dashed var(--border);
    border-radius: var(--radius-s);
    background: var(--bg-raised);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .read :global(.document p) {
    margin: 0;
  }

  .read :global(.document p + p) {
    margin-block-start: var(--space-s);
  }

  .read :global(.document strong) {
    font-weight: 600;
  }

  .buy-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-l);
    margin-block-start: var(--space-3xl);
    padding: var(--space-xl);
    border: 1px solid var(--amber);
    border-radius: var(--radius);
    background:
      radial-gradient(
        circle at 12% 50%,
        color-mix(in srgb, var(--amber) 10%, transparent),
        transparent 60%
      ),
      var(--bg-raised);
  }

  .buy-band__cover {
    flex: none;
    width: 200px;
    height: auto;
    border-radius: var(--radius-s);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
  }

  .buy-band__text {
    flex: 1 1 20rem;
    max-width: 52ch;
  }

  .buy-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-s);
  }

  .buy-band__meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  @media (max-width: 40rem) {
    .buy-band {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-l);
    }
  }
</style>
