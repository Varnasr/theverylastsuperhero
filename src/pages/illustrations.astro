---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * The illustration gallery — including the ones that did not make the book.
 *
 * Images are globbed rather than listed, so dropping a file into
 * src/assets/illustrations puts it on the page. Captions live in CAPTIONS below;
 * anything without one still appears, just without a description.
 */

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/illustrations/*.{png,jpg,jpeg,webp}',
  { eager: true }
);

interface Caption {
  title: string;
  note: string;
  /**
   * The book's own figure legend, transcribed from the manuscript, where this
   * plate carries one.
   *
   * This replaced a hand-set `inBook` boolean. That flag was guesswork — only
   * the first third of the manuscript is machine-readable, so "not in the book"
   * could never be established for the rest, and the page was asserting it
   * anyway. A legend is evidence: it is either printed under the plate or it
   * is not. Absence of one here means unverified, not cut.
   */
  legend?: string;
}

const CAPTIONS: Record<string, Caption> = {
  'delhi-station-2045': { title: 'The Hyperloop at Serenity Junction', note: 'Solar canopies, an elevated maglev line, and travellers moving under soft blue guidance light.', legend: 'The Hyperloop at Serenity Junction' },
  'treasure-room': { title: 'The Treasure Room', note: 'Shelf on shelf of pots, lamps, bottles and bundled cloth, lit low. The room Mr Mehta opens.', legend: 'Mr Mehta shows Sumati the Treasure Room' },
  'professor-with-books': { title: 'Mr Mehta and the Books', note: 'A tall, thin man with silver hair steps down from an old local train, reading, his arms full of books.' },
  'bench-weeping': { title: 'The Bench', note: 'A girl and a large pale dog sitting together on a slatted bench. Pencil.' },
  'cardboard-boxes': { title: 'Behind the Boxes', note: 'A girl standing in a canyon of stacked cardboard.' },
  'chased-by-crow': { title: 'The Crow on the Platform', note: 'A girl and a brown dog running down a platform, a large black crow low behind them.' },
  'nandinis-tea-corner': { title: "Nandini's Tea Corner", note: 'A woman at a station stall, drawn in soft pencil.' },
  'salt-lamp-shack': { title: 'The Lamp in the Shack', note: 'A plank-walled room with straw on the floor and a low red glow at its centre.' },
  'lit-room': { title: 'Rani and Momo', note: 'A green and orange parrot on a stool, and a fat ginger cat beside it, in a bright window corner.' },
  'fly-ash-fields': { title: 'Fly Ash', note: 'A figure alone in a wide white field, fronds bleached to nothing, the air chalky.' },
  'arid-land': { title: 'Cracked Ground', note: 'Figures under wide-brimmed hats and parasols crossing dry, fissured land.' },
  'virtual-layer-flooring': { title: 'Virtual Layer Flooring', note: 'A train corridor lit from the floor in blue, empty.' },
  'bazaar-from-train': { title: 'Bazaars from a Train Window', note: 'Awnings, fabric and crowds sliding past a carriage window.' },
  'rickety-bus': { title: 'The Rickety Bus', note: 'A bus with passengers riding the roof, wheat and mustard on both sides.' },
  'superhero-flees': { title: 'The Bus in the River', note: 'A green bus nose-down in the water beneath a broken span, people wading out along a raft.' },
  'museum': { title: 'The Museum', note: 'Holographic biospheres on plinths, visitors small beneath them.' },
  'fire-dance': { title: 'Around the Fire', note: 'Villagers dancing and clapping round a fire bowl in the evening.' },
  'animal-team': { title: 'The Animals', note: 'A crow and a line of small mammals among marigolds.' },
  'library-disarray': { title: 'The Library, After', note: 'Books off every shelf, pages falling through the aisle like confetti.' },
  'library-librarian': { title: 'In the Stacks', note: 'Four people bent over an open book at a table between tall shelves.' },
  'sumati-face': { title: 'Sumati', note: 'A girl looking straight out, surrounded by drifts of loose paper.' },
  'london-fireplace': { title: 'A Room a Long Way Off', note: 'Wood panelling, bound journals and a roaring fire, and a heavily wrapped man seated before it.' },
  'police-station': { title: 'The Police Station', note: 'Officers lounging at desks among stacked files and papers.' },
  'police-van': { title: 'In the Van', note: 'Two girls and two officers crowded on the bench seats of a moving van.' },
  'station-master-yelling': { title: 'On the Platform', note: 'A girl between two older men in conversation, one in uniform, under a station sign.' },
  'commissioner-room': { title: "The Commissioner's Room", note: 'Polished marble, a heavy desk, framed certificates, and nobody in the chair.' },
  'deep-conversation': { title: 'Two Men Talking', note: 'Close, sepia, one in a hard hat. Neither is looking at the other.' },
  'dog-at-window': { title: 'The Dog and the Projection', note: 'A dog barking at a green holographic spill from a device on a dark floor.' },
  'man-jumping': { title: 'The Homemade Suit', note: 'A caped figure in green and red standing for the camera, a dog beside him, unimpressed.' },
  'vision-board': { title: 'The Vision Board', note: 'Maps, photographs, sticky notes and lengths of string, arranged around one portrait.' },
  'study-a': { title: 'The Archive Wakes', note: 'Two women on cushions among scattered tablets, the library around them lit blue.' },
  'study-b': { title: 'The Empty Floor', note: 'Rows of workstations under hard white light, every chair unoccupied.' },
  'study-c': { title: 'The Desk', note: 'A brass lamp, a rotary telephone, and papers left where someone stopped.' },
  'study-d': { title: 'Down the Corridor', note: 'A caped figure walking a hospital-green corridor, uniformed men on either side.' },
};

const slugOf = (path: string) => path.split('/').pop()!.replace(/\.[a-z]+$/i, '');

const images = Object.entries(files)
  .map(([path, mod]) => {
    const slug = slugOf(path);
    return { slug, src: mod.default, caption: CAPTIONS[slug] };
  })
  // Named pieces first, in the order CAPTIONS declares them; anything unlisted after.
  .sort((a, b) => {
    const keys = Object.keys(CAPTIONS);
    const ai = keys.indexOf(a.slug);
    const bi = keys.indexOf(b.slug);
    return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
  });

const withLegend = images.filter((i) => i.caption?.legend).length;

// A representative image for the social card.
const first = images[0]?.src;
const og = first ? await getImage({ src: first, width: 1200, format: 'jpeg' }) : undefined;
---

<BaseLayout
  title="Illustrations"
  description="The artwork behind The Very Last Superhero — the illustrations that made the book, and the ones that did not."
  image={og?.src}
>
  <div class="shell section">
    <header class="page-head stack">
      <p class="eyebrow">The artwork</p>
      <h1>Illustrations</h1>
      <p class="text-muted lede">
        {images.length} pieces made while writing the book. Some were printed; others were rooms
        described and then cut, characters who lost their scene, versions that were nearly right.
        They are all here, because the world is bigger than the book that came out of it. Where a
        plate carries the book's own figure legend, it is quoted underneath — {withLegend} so far,
        transcribed from the manuscript as more of it becomes readable.
      </p>
    </header>

    <div class="gallery">
      {
        images.map(({ slug, src, caption }) => (
          <figure class="plate" id={slug}>
            <Image
              src={src}
              alt={caption?.note ?? caption?.title ?? ''}
              widths={[400, 700, 1000]}
              sizes="(max-width: 40rem) 92vw, (max-width: 70rem) 45vw, 30rem"
              loading="lazy"
            />
            <figcaption>
              <h2>
                {caption?.title ?? slug.replace(/-/g, ' ')}
                {caption?.legend && <span class="plate__printed">in the book</span>}
              </h2>
              {caption?.note && <p class="text-muted">{caption.note}</p>}
              {caption?.legend && <p class="plate__legend">{caption.legend}</p>}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="note text-muted">
      Artwork by {'Varna Sri Raman'}, generated with AI image tools from written prompts and then
      selected, refined and sequenced by hand. Free to share under
      <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" rel="license noopener"
        >CC BY-NC-ND 4.0</a
      >.
    </p>
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-block-end: var(--space-xl);
  }

  .lede {
    max-width: 60ch;
  }

  .gallery {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fill, minmax(min(26rem, 100%), 1fr));
  }

  .plate {
    margin: 0;
    scroll-margin-block: 6rem;
  }

  .plate img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-sunken);
  }

  .plate figcaption {
    margin-block-start: var(--space-s);
  }

  .plate h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-s);
    font-size: var(--step-1);
  }

  .plate__printed {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber);
    border: 1px solid color-mix(in srgb, var(--amber) 40%, transparent);
    background: color-mix(in srgb, var(--amber) 10%, transparent);
    border-radius: 999px;
    padding: 0.15em 0.6em;
  }

  /* The book's own words for the plate, so it reads as a quotation from the
     printed page rather than another line of site copy. */
  .plate__legend {
    margin-block-start: var(--space-2xs);
    padding-inline-start: var(--space-s);
    border-inline-start: 2px solid color-mix(in srgb, var(--amber) 35%, transparent);
    font-size: var(--step--1);
    font-style: italic;
    color: var(--text-muted);
    max-width: 48ch;
  }

  .plate figcaption p {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    max-width: 48ch;
  }

  .note {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--border);
    font-size: var(--step--1);
    max-width: 60ch;
  }
</style>
