---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * The illustration gallery — including the ones that did not make the book.
 *
 * Images are globbed rather than listed, so dropping a file into
 * src/assets/illustrations puts it on the page. Captions live in CAPTIONS below;
 * anything without one still appears, just without a description.
 */

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/illustrations/*.{png,jpg,jpeg,webp}',
  { eager: true }
);

interface Caption {
  title: string;
  note: string;
  /**
   * The book's own figure legend, transcribed from the manuscript, where this
   * plate carries one.
   *
   * This replaced a hand-set `inBook` boolean. That flag was guesswork — only
   * the first third of the manuscript is machine-readable, so "not in the book"
   * could never be established for the rest, and the page was asserting it
   * anyway. A legend is evidence: it is either printed under the plate or it
   * is not. Absence of one here means unverified, not cut.
   */
  legend?: string;
}

const CAPTIONS: Record<string, Caption> = {
  'salt-lamp-shack': { title: 'The Lamp in the Shack', note: 'A dimly lit shack, straw on the floor, and a salt lamp glowing red in the middle of it.', legend: 'Sumati and Aasma talk by a Salt Lamp' },
  'treasure-room': { title: 'The Treasure Room', note: 'Broken fans, old parchment, coins with holes, shiny metal balls, lamps, embroidered fabric, bottles of every colour.', legend: 'Mr Mehta shows Sumati the Treasure Room' },
  'nandinis-tea-corner': { title: "Nandini's Tea Corner", note: 'The tea stall at the end of the platform, and the woman who tells a lost girl they will figure it out together.' },
  'virtual-layer-flooring': { title: 'Virtual Layer Flooring', note: 'Footsteps leaving a blue blur of soft light along a train corridor.' },
  'superhero-flees': { title: 'The Hero Leaves', note: 'A bus in the river, a collapsed bridge, women and children in the water — and a figure in neon green heading the other way.' },
  'fly-ash-fields': { title: 'Fly Ash', note: 'Pushing the fronds aside to find long white fields of ash behind them.', legend: 'Rohan kneels to see a sole plant sapling in an enormous white field of ash' },
  'bench-weeping': { title: 'The Bench', note: 'The moment before the dog gets a name.' },
  'cardboard-boxes': { title: 'Behind the Boxes', note: 'Pulling apart a pile of cardboard to find someone already living there.' },
  'chased-by-crow': { title: 'The Crow', note: 'Down the platform at speed, a girl, a dog, and a bird that will not be shooed.' },
  'professor-with-books': { title: 'Papa and the Books', note: 'Stepping off a train under a pile of books, watched from the platform.' },
  'delhi-station-2045': { title: 'The Station', note: 'Solar panels, a hyperloop, and robots that guide confused travellers with soft blue light.', legend: 'The Hyperloop at Serenity Junction' },
  'arid-land': { title: 'Cracked Ground', note: 'Fields that were once lush green, bearing the brunt of it. Wide-brimmed hats and parasols.' },
  'animal-team': { title: 'The Animals', note: 'A mongoose, a cat, a dog, a parrot, a crow. Between them they upend more scan sweeps than the Resistance ever planned.' },
  'library-disarray': { title: 'The Library, After', note: 'Books off the shelves, pages fluttering like confetti.' },
  'library-librarian': { title: 'The Head Librarian', note: 'A stern woman at a high table, surrounded by books, being asked for something she is not supposed to give.' },
  'sumati-face': { title: 'Sumati', note: 'Looking up.' },
  'london-fireplace': { title: 'A Room in London', note: 'Wood panelling, law journals, a roaring fire, and a man who is a long way from Delhi.' },
  'bazaar-from-train': { title: 'Bazaars from a Train Window', note: 'Colourful fabric and shimmering jewels, the smell of street food, all of it going past.' },
  'museum': { title: 'The Museum', note: 'Holographic biospheres, ecosystem simulations, augmented tours through an Earth that is no longer there.' },
  'rickety-bus': { title: 'The Rickety Bus', note: 'Vibrant saris, dhotis, children by the roadside, fields of wheat and mustard.' },
  'fire-dance': { title: 'Around the Fire', note: 'A girl, her dog, five villagers and a drum. It is evening, and it is festive.' },
  'police-station': { title: 'The Police Station', note: 'Potbellied policemen lounging, uniforms stained with sweat and dust, the air thick with stale tobacco.' },
  'police-van': { title: 'In the Van', note: 'Two girls, a professor and a middle-aged woman, huddled in with three officers.' },
  'station-master-yelling': { title: 'The Station Master', note: 'An unpleasant fellow with a smirk, yelling at people who have done nothing.' },
  'commissioner-room': { title: "The Commissioner's Room", note: 'Polished marble under warm golden light. Awards and certificates showcasing a career of dedication to law and order.' },
  'dog-at-window': { title: 'Barking at the Window', note: 'Something outside is worth the noise.' },
  'lit-room': { title: 'A Small Bright Room', note: 'Brightly lit and poorly furnished.' },
  'man-jumping': { title: 'The Jump', note: 'A tall lean man with a pot belly, mid-air.' },
  'deep-conversation': { title: 'Deep Conversation', note: 'A young man, entirely absorbed.' },
  'vision-board': { title: 'The Vision Board', note: 'A complex board assembled to find one person.' },
  'study-a': { title: 'Study', note: 'One of a set of refinement passes.' },
  'study-b': { title: 'Study', note: 'One of a set of refinement passes.' },
  'study-c': { title: 'Study', note: 'One of a set of refinement passes.' },
  'study-d': { title: 'Study', note: 'One of a set of refinement passes.' },
};

const slugOf = (path: string) => path.split('/').pop()!.replace(/\.[a-z]+$/i, '');

const images = Object.entries(files)
  .map(([path, mod]) => {
    const slug = slugOf(path);
    return { slug, src: mod.default, caption: CAPTIONS[slug] };
  })
  // Named pieces first, in the order CAPTIONS declares them; anything unlisted after.
  .sort((a, b) => {
    const keys = Object.keys(CAPTIONS);
    const ai = keys.indexOf(a.slug);
    const bi = keys.indexOf(b.slug);
    return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
  });

const withLegend = images.filter((i) => i.caption?.legend).length;

// A representative image for the social card.
const first = images[0]?.src;
const og = first ? await getImage({ src: first, width: 1200, format: 'jpeg' }) : undefined;
---

<BaseLayout
  title="Illustrations"
  description="The artwork behind The Very Last Superhero — the illustrations that made the book, and the ones that did not."
  image={og?.src}
>
  <div class="shell section">
    <header class="page-head stack">
      <p class="eyebrow">The artwork</p>
      <h1>Illustrations</h1>
      <p class="text-muted lede">
        {images.length} pieces made while writing the book. Some were printed; others were rooms
        described and then cut, characters who lost their scene, versions that were nearly right.
        They are all here, because the world is bigger than the book that came out of it. Where a
        plate carries the book's own figure legend, it is quoted underneath — {withLegend} so far,
        transcribed from the manuscript as more of it becomes readable.
      </p>
    </header>

    <div class="gallery">
      {
        images.map(({ slug, src, caption }) => (
          <figure class="plate" id={slug}>
            <Image
              src={src}
              alt={caption?.note ?? caption?.title ?? ''}
              widths={[400, 700, 1000]}
              sizes="(max-width: 40rem) 92vw, (max-width: 70rem) 45vw, 30rem"
              loading="lazy"
            />
            <figcaption>
              <h2>
                {caption?.title ?? slug.replace(/-/g, ' ')}
                {caption?.legend && <span class="plate__printed">in the book</span>}
              </h2>
              {caption?.note && <p class="text-muted">{caption.note}</p>}
              {caption?.legend && <p class="plate__legend">{caption.legend}</p>}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="note text-muted">
      Artwork by {'Varna Sri Raman'}, generated with AI image tools from written prompts and then
      selected, refined and sequenced by hand. Free to share under
      <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" rel="license noopener"
        >CC BY-NC-ND 4.0</a
      >.
    </p>
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-block-end: var(--space-xl);
  }

  .lede {
    max-width: 60ch;
  }

  .gallery {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fill, minmax(min(26rem, 100%), 1fr));
  }

  .plate {
    margin: 0;
    scroll-margin-block: 6rem;
  }

  .plate img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-sunken);
  }

  .plate figcaption {
    margin-block-start: var(--space-s);
  }

  .plate h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-s);
    font-size: var(--step-1);
  }

  .plate__printed {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber);
    border: 1px solid color-mix(in srgb, var(--amber) 40%, transparent);
    background: color-mix(in srgb, var(--amber) 10%, transparent);
    border-radius: 999px;
    padding: 0.15em 0.6em;
  }

  /* The book's own words for the plate, so it reads as a quotation from the
     printed page rather than another line of site copy. */
  .plate__legend {
    margin-block-start: var(--space-2xs);
    padding-inline-start: var(--space-s);
    border-inline-start: 2px solid color-mix(in srgb, var(--amber) 35%, transparent);
    font-size: var(--step--1);
    font-style: italic;
    color: var(--text-muted);
    max-width: 48ch;
  }

  .plate figcaption p {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    max-width: 48ch;
  }

  .note {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--border);
    font-size: var(--step--1);
    max-width: 60ch;
  }
</style>
