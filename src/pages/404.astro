---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Record not found" description="This record is not in the archive." noindex>
  <div class="shell section notfound">
    <p class="eyebrow">Error 404</p>
    <h1>This record is not in the archive</h1>
    <p class="text-muted">
      It may have been deleted in the 2061 curriculum rewrite, lost when the embankments failed, or
      simply mistyped. The last of those is the easiest to fix.
    </p>
    <div class="actions">
      <a class="button button--primary" href="/">Return to the archive</a>
      <a class="button" href="/search">Search for it</a>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    max-width: 44rem;
    text-align: center;
    padding-block: var(--space-3xl);
  }

  .notfound h1 {
    margin-block: var(--space-s) var(--space-m);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    justify-content: center;
    margin-block-start: var(--space-l);
  }
</style>
