---
import BaseLayout from '../layouts/BaseLayout.astro';
import SecondEdition from '../components/SecondEdition.astro';
import Newsletter from '../components/Newsletter.astro';
import BuyButton from '../components/BuyButton.astro';
import { getCollection, render } from 'astro:content';

/**
 * "On the Making of The Very Last Superhero", adapted from the author's own
 * afterword and annotated bibliography. Both are edited for the site and follow
 * the writing standards in CLAUDE.md. Bibliographic citations (author, title,
 * publisher, year) stay exactly as printed.
 */

const works = (await getCollection('reading')).sort((a, b) => a.data.order - b.data.order);
const readings = await Promise.all(
  works.map(async (w) => ({ ...w, Body: (await render(w)).Content }))
);
const groups: { name: string; works: typeof readings }[] = [];
for (const w of readings) {
  const last = groups.at(-1);
  if (last?.name === w.data.section) last.works.push(w);
  else groups.push({ name: w.data.section, works: [w] });
}
---

<BaseLayout
  title="On the Making of The Very Last Superhero"
  description="The author's afterword: why the book was written, what is real in it, and what the illustrations actually are."
  readingProgress
>
  <div class="shell section">
    <header class="page-head stack">
      <p class="eyebrow">Adapted from the afterword</p>
      <h1>On the Making of <em>The Very Last Superhero</em></h1>
    </header>

    <div class="prose making stack">
      <p class="lede">This story is about what we believed superheroes could save us from, and about what happened when they did not save us.</p>

      <p><em>The Very Last Superhero</em> is grounded in Delhi’s actual, ongoing reality. The Okhla Waste-to-Energy plant exists, and so does the heat. The failed technology exists, and so does the air so dense with particulate that memory feels physical. All of this is real. The book builds its map of the future outward from the present.</p>

      <p>The world of this story is shaped by material capitalism, climate collapse and abandoned infrastructures presented as innovation. The superheroes were never anything more than state mechanisms. They were designed for obedience, engineered for loyalty and incapable of love. When they fell, they left behind their technology, their propaganda and the communities they claimed to protect.</p>

      <p>Sumati is a child trying to understand what she has inherited. Her search for her father becomes a search for the Resistance and then for something older, which is shared memory. She learns from relics, ruins, animals and ghosts, and she learns by listening. This story is about care as resistance, which includes love for the nonhuman, the forgotten and the othered. It is also about what it means to remember communally, across time.</p>

      <p>The Resistance fought with documentation, doubt, salt lamps, cracked badges and memory tablets that outlived power grids. Its symbol was the Firebird, etched on walls and drawn in soot. Nobody made it official and nobody claimed it, and it appears everywhere. It reminds the reader that after a collapse the truth has outlived its suppressors.</p>

      <p>The reprogrammed intelligence in the story, p.ai, was once P.A.I., which stood for Pandemonium Algorithmic Indoctrination and was designed to predict and punish. Rishi Mehta, at the age of eleven, changed the dots, rewrote the code and taught it to listen and to stop obeying. The old system was replaced by a differently designed one.</p>

      <p>The illustrations in this book were made through generative tools, manual curation and narrative revision. Each image holds part of the story. Some are memories that the characters never see, some are false and some are true. All of them serve as records of the story’s world.</p>

      <p>This book is about what survives collapse: animals, stories, data fragments, broken technology, friendship and the long, stubborn refusal to give up on one another.</p>

      <p>Perhaps most of all, it is about how to live when the heroes are gone and we are what is left.</p>

    </div>

    <section class="reading" id="further-reading">
      <header class="reading__head">
        <h2>Further reading</h2>
        <p class="text-muted">
          Adapted from the book's annotated bibliography: {works.length} works in {groups.length}
          groups, each with the author's note on why it matters to the novel. The citations are as
          printed, and the notes have been edited for the site.
        </p>
      </header>

      {
        groups.map((group) => (
          <div class="rgroup">
            <h3 class="rgroup__name">{group.name}</h3>
            <ol class="works">
              {group.works.map(({ id, data, Body }) => (
                <li class="work" id={id}>
                  <p class="work__author">{data.author}</p>
                  <h4>{data.title}</h4>
                  {data.publisher && (
                    <p class="work__pub">
                      {data.publisher}
                      {data.year && `, ${data.year}`}
                    </p>
                  )}
                  <div class="work__note prose">
                    <Body />
                  </div>
                  {data.relevance && (
                    <p class="work__rel">
                      <span>Relevance</span> {data.relevance}
                    </p>
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))
      }

      <p class="reading__coda text-muted">
        This list is incomplete. It maps a few intellectual trails that may lead deeper into the
        questions this book only begins to ask.
      </p>
    </section>

    <aside class="after">
      <p class="text-muted">
        Varna Sri Raman is the author and illustrator. The afterword above is adapted from the one
        printed in the book.
      </p>
      <BuyButton placement="making" />
    </aside>
      <Newsletter />
      <SecondEdition />
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-block-end: var(--space-xl);
  }

  .making {
    max-width: 66ch;
  }

  .making .lede {
    font-size: var(--step-1);
    color: var(--text);
    text-wrap: balance;
  }

  .making p:last-child {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--amber);
  }

  .reading {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-xl);
    border-block-start: 1px solid var(--border);
  }

  .reading__head {
    max-width: 62ch;
    margin-block-end: var(--space-2xl);
  }

  .reading__head h2 {
    font-size: var(--step-2);
  }

  .reading__coda {
    margin-block-start: var(--space-2xl);
    max-width: 62ch;
  }

  .rgroup + .rgroup {
    margin-block-start: var(--space-2xl);
  }

  .rgroup__name {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber);
    padding-block-end: var(--space-xs);
    margin-block-end: var(--space-xl);
    border-block-end: 1px solid var(--border);
  }

  .works {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
  }

  .work {
    max-width: 64ch;
    scroll-margin-block-start: 6rem;
  }

  .work__author {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .work h4 {
    font-size: var(--step-1);
    margin-block: var(--space-3xs) var(--space-3xs);
  }

  .work__pub {
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .work__note {
    margin-block-start: var(--space-xs);
    font-size: var(--step--1);
  }

  .work__rel {
    margin-block-start: var(--space-xs);
    padding-inline-start: var(--space-s);
    border-inline-start: 2px solid color-mix(in srgb, var(--amber) 40%, transparent);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .work__rel span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
    display: block;
  }

  .after {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--border);
    max-width: 66ch;
  }

  .after p {
    flex: 1 1 20rem;
    font-size: var(--step--1);
    margin: 0;
  }
</style>
