---
import { site } from '../lib/site';

/**
 * First-party analytics: our own database, no third-party service.
 *
 * No cookie is set and nothing is stored on the device, so there is nothing to
 * consent to. No identifier is sent either — visitors are counted by the day
 * bucket a row lands in, not by anything that follows a person around.
 *
 * Do Not Track and Global Privacy Control are honoured even though a cookieless
 * first-party count arguably need not.
 */
const { firstParty, supabaseUrl, supabaseKey } = site.analytics;
const on = firstParty && supabaseUrl && supabaseKey;
---

{
  on && (
    <script is:inline define:vars={{ url: `${supabaseUrl}/rest/v1/postheroic_events`, key: supabaseKey }}>
      {`(() => {
        if (navigator.doNotTrack === '1' || window.doNotTrack === '1' || navigator.globalPrivacyControl) return;

        // Which site sent them, not which page — a referring path can carry
        // more about a reader than we have any use for.
        let referrer = '';
        try {
          const r = new URL(document.referrer);
          if (r.hostname !== location.hostname) referrer = r.hostname;
        } catch {}

        const send = (kind, meta) => {
          const body = JSON.stringify({
            kind,
            path: location.pathname,
            referrer,
            form_factor: window.innerWidth < 700 ? 'phone' : 'desktop',
            meta: meta || null,
          });
          const headers = {
            apikey: key,
            Authorization: 'Bearer ' + key,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          };
          // keepalive so a buy click survives the page being torn down.
          fetch(url, { method: 'POST', headers, body, keepalive: true, mode: 'cors' }).catch(() => {});
        };

        send('pageview');

        document.addEventListener('click', (e) => {
          const buy = e.target instanceof Element && e.target.closest('[data-buy]');
          if (buy) send('buy_click', { placement: buy.className || null });
        }, { capture: true });

        document.addEventListener('submit', (e) => {
          const f = e.target;
          if (f instanceof HTMLFormElement && f.name) send('form_submit', { form: f.name });
        }, { capture: true });
      })();`}
    </script>
  )
}
